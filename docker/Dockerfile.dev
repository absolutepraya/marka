FROM node:24.18.1-slim

WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Match the production Node and Debian libc family for native modules.
RUN apt-get update \
    && apt-get install --no-install-recommends -y make g++ python3 python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g corepack@latest && corepack enable pnpm

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
