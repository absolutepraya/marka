{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "bash scripts/setup-t3-worktree.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Start dev",
      "command": "pnpm dev:start -d",
      "icon": "play"
    },
    {
      "name": "Stop dev",
      "command": "pnpm dev:stop",
      "icon": "debug"
    }
  ]
}
