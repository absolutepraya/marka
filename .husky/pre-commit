# react.doctor — advisory only: scans staged files in React packages, prints a
# health report, and NEVER blocks the commit (`|| true`). Runs first so it can't
# affect the gating commands below.
pnpm doctor:staged || true

# apps/web is intentionally on Tailwind v4 while landing/extension/mobile/tooling
# stay on v3 (the web UI haul). Tell sherif that tailwindcss + @tailwindcss/typography
# version skew across the workspace is expected, not a mistake. apps/cloudflare
# needs Vitest 4 for @cloudflare/vitest-plugin while the rest stay on Vitest 3.
pnpm preflight
pnpm exec sherif --ignore-dependency tailwindcss --ignore-dependency @tailwindcss/typography --ignore-dependency vitest
pnpm run --filter @karakeep/open-api check
