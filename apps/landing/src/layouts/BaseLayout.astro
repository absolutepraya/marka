---
import "../styles/global.css";
import { landing } from "../content/landing";
import { LOCAL_PREVIEW_ORIGIN } from "../constants";

const siteOrigin = Astro.site ?? new URL(LOCAL_PREVIEW_ORIGIN);
const canonicalUrl = new URL("/", siteOrigin).href;
const socialImageUrl = new URL(landing.metadata.socialImage, siteOrigin).href;
const isLocalPreview = ["localhost", "127.0.0.1", "::1", "[::1]"].includes(
  siteOrigin.hostname,
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Marka",
  url: canonicalUrl,
  description: landing.metadata.description,
  applicationCategory: "ProductivityApplication",
  operatingSystem: "Web",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f6f1" />
    <meta name="robots" content={isLocalPreview ? "noindex, nofollow" : "index, follow"} />
    <title>{landing.metadata.title}</title>
    <meta name="description" content={landing.metadata.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/brand/marka/marka-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/marka/marka-apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marka" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={landing.metadata.title} />
    <meta property="og:description" content={landing.metadata.description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={landing.metadata.socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={landing.metadata.title} />
    <meta name="twitter:description" content={landing.metadata.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={landing.metadata.socialImageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
