---
import Layout from "../layouts/Layout.astro";
import { landing } from "../content/landing";
---

<Layout>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">{landing.hero.eyebrow}</p>
      <h1 id="hero-title">{landing.hero.title}</h1>
      <p>{landing.hero.description}</p>
      <p>{landing.hero.supportingNote}</p>
      <div class="hero__actions">
        <a class="button" href={landing.primaryCta.href}>{landing.primaryCta.label}</a>
        <a class="text-link" href={landing.secondaryCta.href}>{landing.secondaryCta.label}</a>
      </div>
    </section>
  </main>
</Layout>
