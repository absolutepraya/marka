---
import { landing } from "../content/landing";
---

<section
  class="ownership-close"
  data-page-section="ownership-close"
  aria-labelledby="ownership-title"
>
  <div class="ownership-close__inner">
    <p class="eyebrow">{landing.ownership.eyebrow}</p>
    <h2 id="ownership-title">{landing.ownership.title}</h2>
    <p class="ownership-close__description">
      {landing.ownership.description}
    </p>
    <div class="hero__actions">
      <a class="button" href={landing.primaryCta.href}>
        {landing.primaryCta.label}
      </a>
      <a class="text-link" href={landing.secondaryCta.href}>
        {landing.secondaryCta.label}
      </a>
    </div>
  </div>
</section>
