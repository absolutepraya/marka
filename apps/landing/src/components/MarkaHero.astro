---
import { landing } from "../content/landing";
---

<section
  class="marka-hero"
  data-page-section="hero"
  aria-labelledby="hero-title"
>
  <p class="eyebrow">{landing.hero.eyebrow}</p>
  <h1 id="hero-title">{landing.hero.title}</h1>
  <p class="marka-hero__description">{landing.hero.description}</p>
  <p class="marka-hero__examples">{landing.hero.supportingNote}</p>
  <div class="hero__actions">
    <a class="button" href={landing.primaryCta.href}>
      {landing.primaryCta.label}
    </a>
    <a class="text-link" href={landing.secondaryCta.href}>
      {landing.secondaryCta.label}
    </a>
  </div>
</section>
