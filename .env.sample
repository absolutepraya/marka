# See the repository documentation for configuration details.
DATA_DIR=<path>
NEXTAUTH_SECRET=<secret>

# Shared local development infrastructure.
MEILI_ADDR=http://127.0.0.1:7700
MEILI_INDEX_PREFIX=
# For local loopback Chrome, BROWSER_WEB_URL follows MARKA_DEV_CHROME_PORT.
# Set both explicitly when using a custom browser endpoint.
BROWSER_WEB_URL=http://127.0.0.1:9250
MARKA_DEV_CHROME_PORT=9250

# Operator helper for pulling the full prod state into local development.
# Real values belong only in .env.
# The personal VPS compose project lives at /home/praya/marka, not /marka.
KARAKEEP_PROD_SSH_HOST=vps
KARAKEEP_PROD_SSH_USER=
KARAKEEP_PROD_COMPOSE_DIR=/home/praya/marka
KARAKEEP_PROD_COMPOSE_PROJECT=karakeep
KARAKEEP_PROD_COMPOSE_SERVICE=web
KARAKEEP_PROD_EXPORT_IMAGE=alpine:3.20
EMBEDDING_ENABLE_AUTO_INDEXING=true
EMBEDDING_TEXT_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
OCR_USE_LLM=true
OCR_PDF_MAX_PAGES=20
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_CHUNK_SECONDS=600
TRANSCRIPTION_JOB_TIMEOUT_SEC=1800
CRAWLER_STORE_SCREENSHOT=true
CRAWLER_FULL_PAGE_SCREENSHOT=false
CRAWLER_STORE_PDF=false
CRAWLER_FULL_PAGE_ARCHIVE=false
CRAWLER_VIDEO_DOWNLOAD=false
ASSET_PREPROCESSING_NUM_WORKERS=1
WORKER_PROFILE=screenshot-first
